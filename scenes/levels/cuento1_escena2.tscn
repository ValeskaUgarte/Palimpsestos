[node name="Ethan" parent="." unique_id=962963380 instance=ExtResource("ethan")]
position = Vector2(3350, 272)
dialogue_lines = Array[String](["Ethan-Ese cartel dice camino corto y camino de las flores. Yo no me fío de ninguno de los dos.", "Elliot-¿Y la niña? Ya no la veo.", "Ethan-Los cuentos viejos tenían una palabra para quien finge ser bueno. Está escrita en la roca de la cueva. No se rompe: se abre si le cuentas el cuento de la niña en el orden en que ocurrió."])
repeatable = true

[node name="Motion" parent="Ethan" index="0" unique_id=606193905]
position = Vector2(-13.743243, -173.1892)
scale = Vector2(0.24324325, 0.24324325)
animation = &"idle"

[node name="Caperucita" parent="." unique_id=216227411 instance=ExtResource("caperucita")]
position = Vector2(4740, 144)
dialogue_lines = Array[String](["Caperucita-Mamá me dio un pastel y una botella para mi abuelita. Salí de casa esa misma mañana.", "Caperucita-Entré en el bosque y allí me crucé con un lobo muy educado, que me saludó con muy buenos modales.", "Caperucita-Me dijo: «Mira qué flores tan bonitas». Y me aparté del camino a recogerlas.", "Caperucita-Así cuento siempre mi cuento: primero la casa, después el bosque y al final las flores."])
repeatable = true

[node name="Motion" parent="Caperucita" index="0" unique_id=822710853]
position = Vector2(-0.16129032, -76.29032)
scale = Vector2(0.16129032, 0.16129032)
animation = &"idle"

[node name="Abuelita" parent="." unique_id=978886099 instance=ExtResource("abuelita")]
position = Vector2(10640, 278)
dialogue_lines = Array[String](["Abuelita-¡Ay, qué bien que llegan! Pasen, pasen.", "Abuelita-Antes de comer, vuelve a la cueva. La roca guarda un camino que aún no leíste.", "Elliot-¿Qué cueva? No vi ninguna.", "Jhon-Quizás no prestaste atención.", "Abuelita-La roca solo se abre a quien cuenta el cuento en orden: casa, lobo y flores.", "Abuelita-Los anillos se leen de fuera hacia dentro. El de fuera y el de dentro giran con el sol; el del medio, contra él. La luna y el hongo no cuentan."])

[node name="Motion" parent="Abuelita" index="0" unique_id=1628143642]
position = Vector2(-3.2410533, -145.44228)
scale = Vector2(0.20256583, 0.20256583)

