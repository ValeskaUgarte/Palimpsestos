[node name="ClueSign" type="Area2D" parent="." unique_id=100000001]
position = Vector2(14750, 220)
collision_layer = 0
collision_mask = 2
script = ExtResource("9_clue")
lines = Array[String](["En la roca, alguien grabó el cuento tal como se contaba antes de que lo suavizaran.", "Una marca: una niña lleva pan y leche a casa de su abuela. En el cruce la espera un lobo: «¿Por qué camino irás, el de los alfileres o el de las agujas?».", "Dos marcas: ella elige el de los alfileres y se entretiene juntándolos. El lobo toma el otro, más corto, y llega primero.", "Tres marcas: lo que pasó dentro de la casa, la roca no lo cuenta. Alguien raspó esa parte. En esa versión no había cazador, ni nadie que abriera la panza del lobo."])
speaker_name = "Nota en la roca"

