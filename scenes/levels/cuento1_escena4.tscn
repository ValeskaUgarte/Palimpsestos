[node name="S4_Llegada" type="Area2D" parent="." unique_id=1382576158]
position = Vector2(420, 230)
collision_layer = 0
collision_mask = 2
script = ExtResource("13_story")
conversation_lines = Array[String](["Siguen los pasos de la joven hasta la casa del bosque. Stephy y ella han entrado primero.", "Elliot-Si la puerta está abierta, alguien nos espera. O alguien se fue con prisa."])

[node name="CollisionShape2D" type="CollisionShape2D" parent="S4_Llegada" unique_id=1776524431]
shape = SubResource("TrigShape4")

[node name="S4_Puerta" type="Area2D" parent="." unique_id=151087305]
position = Vector2(600, 230)
collision_layer = 0
collision_mask = 2
script = ExtResource("13_story")
conversation_lines = Array[String](["La puerta de la casa está abierta, y dentro la chimenea todavía guarda calor.", "Alguien se marchó de aquí con prisa. O con hambre."])

[node name="CollisionShape2D" type="CollisionShape2D" parent="S4_Puerta" unique_id=458064093]
shape = SubResource("TrigShape4")

[node name="S4_Mesa" type="Area2D" parent="." unique_id=591791647]
position = Vector2(720, 230)
collision_layer = 0
collision_mask = 2
script = ExtResource("13_story")
conversation_lines = Array[String](["La mesa está puesta para dos. En el platón quedan restos de carne cortada en rebanadas, y la grasa ya se ha cuajado.", "Junto al platón hay una botella de cristal con un fondo oscuro y espeso. No huele a vino.", "Un camino más corto lleva hasta aquí. Quien lo tomó llegó primero y tuvo tiempo de poner la mesa."])

[node name="CollisionShape2D" type="CollisionShape2D" parent="S4_Mesa" unique_id=256078402]
shape = SubResource("TrigShape4")

[node name="S4_Chimenea" type="Area2D" parent="." unique_id=1059193980]
position = Vector2(1380, 230)
collision_layer = 0
collision_mask = 2
script = ExtResource("13_story")
conversation_lines = Array[String](["Entre las brasas quedan jirones de tela roja y un delantal medio quemado. Alguien los echó al fuego, uno por uno.", "Hay cosas que, una vez dentro de esta casa, nunca más se necesitan."])

[node name="CollisionShape2D" type="CollisionShape2D" parent="S4_Chimenea" unique_id=1665762080]
shape = SubResource("TrigShape4")

[node name="S4_Gato" type="Area2D" parent="." unique_id=51208484]
position = Vector2(1914, 214)
collision_layer = 0
collision_mask = 2
script = ExtResource("13_story")
conversation_lines = Array[String](["Un gato gris los observa desde lo alto de la cómoda, con los ojos muy abiertos. Mira a la joven. Solo a ella.", "Gato-¡Cochina!", "Gato-Has comido la carne y has bebido la sangre de tu abuela.", "Nadie se mueve. La joven tampoco.", "Caperucita-Estaba muy rica.", "Caperucita-Me dijo que comiera. Que en la alacena había carne y vino, y que ella ya no podía.", "Caperucita-Me pidió que echara mis cosas al fuego, una por una: el delantal, la capa... Y cada vez me decía lo mismo: «Nunca más la necesitarás».", "Caperucita-Yo le pregunté por sus manos, por sus ojos, por sus uñas, por sus dientes. Cada respuesta me la sabía antes de oírla.", "Caperucita-Pero seguí preguntando. Así es como se cuenta, ¿no? Así tiene que contarse.", "Caperucita-Y la última respuesta fue: «Para comerte mejor».", "La joven se mira las manos, como si buscara en ellas lo que ya no está.", "Stephy-No sigas. Mírame a mí.", "Caperucita-Pero estoy aquí... ¿Por qué sigo aquí?"])

[node name="CollisionShape2D" type="CollisionShape2D" parent="S4_Gato" unique_id=26464357]
position = Vector2(-86, -11)
shape = SubResource("TrigShape4")

[node name="S4_Cama" type="Area2D" parent="." unique_id=1757813770]
position = Vector2(2200, 230)
collision_layer = 0
collision_mask = 2
script = ExtResource("13_story")
conversation_lines = Array[String](["La cama está deshecha. Las sábanas conservan la forma de un cuerpo grande y peludo que se acostó a esperar.", "Sobre la almohada hay un camisón de anciana, hecho jirones y manchado. Nadie lo ha lavado todavía.", "Elliot-¿Y la dueña de esta casa?", "En algún lugar, alguien ha dejado de escribir su final."])

[node name="CollisionShape2D" type="CollisionShape2D" parent="S4_Cama" unique_id=977043895]
shape = SubResource("TrigShape4")
