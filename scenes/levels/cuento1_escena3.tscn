[node name="ThomasIntro" type="Area2D" parent="." unique_id=20677953]
position = Vector2(5344, 230)
collision_layer = 0
collision_mask = 2
script = ExtResource("13_story")
conversation_speakers = Array[String](["Thomas", "Elliot", "Thomas", "Ethan", "Thomas"])
conversation_lines = Array[String](["¿Acaso no ven tremenda bestia tras esa niña y ustedes solo miran?", "¿Qué demonios? Yo no vi nada, solo a una jovencita corriendo - contesta Elliot con temor.", "¿Acaso no ves? Una bestia enorme, tenemos que hacer algo.", "No, no, no, a mí no me metan. - dice Ethan retrocediendo.", "Cobarde. - y se dirige a Jhon y Elliot - ¿Y ustedes?"])
