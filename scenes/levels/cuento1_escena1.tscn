[node name="Narr_Pan" type="Area2D" parent="." unique_id=833739290]
position = Vector2(300, 260)
collision_layer = 0
collision_mask = 2
script = ExtResource("13_story")
lines = Array[String](["En aquel pueblo se hablaba de pan y de recetas, como si el mañana fuera cosa segura. Era la última hora en que alguien lo creería."])

[node name="CollisionShape2D" type="CollisionShape2D" parent="Narr_Pan" unique_id=1888707052]
shape = SubResource("ZonaNarracion")

[node name="Conv_Padres_HyG" type="Area2D" parent="." unique_id=146071909]
position = Vector2(1295, 260)
collision_layer = 0
collision_mask = 2
script = ExtResource("13_story")
conversation_speakers = Array[String](["Madre", "Padre", "Madre", "Padre"])
conversation_lines = Array[String](["No queda ni una corteza, y los niños lloran de hambre.", "Solo nos queda un último pan. Para los cuatro no alcanza.", "Mañana los dejaremos en lo más espeso del bosque.", "Que Dios me perdone."])
conversation_portraits = Array[Texture2D]([null, null, null, null])

[node name="CollisionShape2D" type="CollisionShape2D" parent="Conv_Padres_HyG" unique_id=1914116767]
shape = SubResource("ZonaConversacion")

[node name="Narr_Bosque_Joven" type="Area2D" parent="." unique_id=1126060623]
position = Vector2(4200, 260)
collision_layer = 0
collision_mask = 2
script = ExtResource("13_story")
lines = Array[String](["El camino dejó atrás las casas con la misma indiferencia con que se deja atrás a quien ya no sirve. Los árboles se cerraron. Donde la luz se retira, algo más antiguo ocupa su lugar.", "Una joven cruzó el camino sin mirar a nadie, como cruzan los que ya saben adónde van. Tras ella, a prudente distancia, alguien que no quería ser visto."])

[node name="CollisionShape2D" type="CollisionShape2D" parent="Narr_Bosque_Joven" unique_id=1622295320]
shape = SubResource("ZonaNarracion")

[node name="Conv_HombreBosque" type="Area2D" parent="." unique_id=478777133]
position = Vector2(5450, 260)
collision_layer = 0
collision_mask = 2
script = ExtResource("13_story")
conversation_speakers = Array[String](["Hombre del bosque", "Elliot", "Hombre del bosque"])
conversation_lines = Array[String](["¡Alto ahí! ¿Cómo te atreves a venir a mi bosque? No eres de por aquí.", "¿Qué…?", "Los que no son de aquí no suelen volver a salir."])
conversation_portraits = Array[Texture2D]([null, ExtResource("15_elliot_portrait"), null])

[node name="CollisionShape2D" type="CollisionShape2D" parent="Conv_HombreBosque" unique_id=1160870016]
shape = SubResource("ZonaConversacion")

[node name="Conv_HombreBosque_Despues" type="Area2D" parent="." unique_id=908533217]
position = Vector2(5800, 260)
collision_layer = 0
collision_mask = 2
script = ExtResource("13_story")
conversation_speakers = Array[String](["", "Elliot"])
conversation_lines = Array[String](["Algo en la espesura habló más fuerte que su hambre, y el hombre se fue como quien vuelve a su puesto.", "¿Qué rayos fue eso? ¿Está como poseído? ¿Qué fue lo que lo hizo escapar? ¿Y dónde demonios estoy?"])
conversation_portraits = Array[Texture2D]([null, ExtResource("15_elliot_portrait")])

[node name="CollisionShape2D" type="CollisionShape2D" parent="Conv_HombreBosque_Despues" unique_id=1157230644]
shape = SubResource("ZonaConversacion")

[node name="Narr_Cruce" type="Area2D" parent="." unique_id=356332954]
position = Vector2(7850, 260)
collision_layer = 0
collision_mask = 2
script = ExtResource("13_story")
lines = Array[String](["Hay decisiones que se toman a la ligera y se pagan despacio. Uno de los caminos llegaba antes. Elliot no lo sabía. El bosque sí."])

[node name="CollisionShape2D" type="CollisionShape2D" parent="Narr_Cruce" unique_id=1066245895]
shape = SubResource("ZonaNarracion")

[node name="Conv_Hansel_Gretel" type="Area2D" parent="." unique_id=1056514378]
position = Vector2(9555, 260)
collision_layer = 0
collision_mask = 2
script = ExtResource("13_story")
conversation_speakers = Array[String](["Niña", "Niño", "Niña", "Niño", ""])
conversation_lines = Array[String](["Hermano, tengo hambre.", "Aguanta un poco. Dejé migas de pan por todo el camino; solo tenemos que seguirlas.", "Hermano… ya no hay migas.", "Los pájaros.", "Dos niños aprendían, demasiado pronto, que el bosque no devuelve lo que se le deja."])
conversation_portraits = Array[Texture2D]([null, null, null, null, null])

[node name="CollisionShape2D" type="CollisionShape2D" parent="Conv_Hansel_Gretel" unique_id=721179328]
shape = SubResource("ZonaConversacion")

