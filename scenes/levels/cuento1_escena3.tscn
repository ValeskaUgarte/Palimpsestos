[node name="Foto_familiar" type="Area2D" parent="RutaCuento" unique_id=1820850223]
position = Vector2(2763, 320)
script = ExtResource("pickup_gd")
lines = Array[String](["Una foto familiar, fuera de lugar en mitad del camino. Tras ella, un mensaje escrito a mano:", "«En la salud y en la pobreza… No son solo votos del matrimonio…»"])
key = "escena3_foto"
icon_texture = ExtResource("pk_foto")
draw_width = 58.0

[node name="S3_FotoAviso" type="Area2D" parent="." unique_id=1432800345]
position = Vector2(2610, 230)
collision_layer = 0
collision_mask = 2
script = ExtResource("13_story")
conversation_lines = Array[String](["Jhon detiene su marcha: un objeto fuera de lugar ha llamado su atención. Es una foto familiar y, tras ella, hay un mensaje."])

[node name="CollisionShape2D" type="CollisionShape2D" parent="S3_FotoAviso" unique_id=1503163969]
shape = SubResource("TrigShape3")

[node name="S3_Aullido" type="Area2D" parent="." unique_id=1921678176]
position = Vector2(3019, 230)
collision_layer = 0
collision_mask = 2
script = ExtResource("13_story")
conversation_lines = Array[String](["Un aullido los saca de sus pensamientos: a Jhon, de la foto y su mensaje; a Elliot, de su curiosidad por ambos. Y, de pronto, un grito desgarrador a poca distancia.", "Elliot-¿Eso fue un grito?", "Jhon-Viene de más adelante. Vamos."])

[node name="CollisionShape2D" type="CollisionShape2D" parent="S3_Aullido" unique_id=1199215463]
shape = SubResource("TrigShape3")

[node name="S3_RangerVuelve" type="Area2D" parent="." unique_id=1199375951]
position = Vector2(3376, 230)
collision_layer = 0
collision_mask = 2
script = ExtResource("13_story")
conversation_lines = Array[String](["Al dirigir su atención al grito, vuelve a aparecer el mismo hombre del comienzo: el guardabosque, con nuevas ganas de atacar.", "Ranger-¡¡¡Criaturas apestosas, van a ver!!!", "Jhon-¿Lo conocemos?", "Elliot-Un viejo amigo.", "Ranger Wood ataca, y Elliot y Jhon contraatacan con desesperación. Ninguno de los dos sabe pelear, y las criaturas ya fueron bastante difíciles como para enfrentarse a un hombre tan grande y agresivo."])

[node name="CollisionShape2D" type="CollisionShape2D" parent="S3_RangerVuelve" unique_id=594545906]
shape = SubResource("TrigShape3")

[node name="S3_RangerCae" type="Node" parent="." unique_id=1261459702]
script = ExtResource("defeat_gd")
enemy_path = NodePath("../RangerWood")
lines = Array[String](["La pelea fue agotadora, pero por fin lograron derrotarlo. Mientras cae, el guardabosque dice algo que los deja intrigados y más asustados que al principio.", "Ranger-No continúen... este no es su lugar.", "Elliot-¿Qué quiso decir con eso? Esta es la tercera cosa rara que nos pasa hoy.", "Jhon-Primero la foto, luego el grito, ahora esto. Algo en este bosque no encaja.", "Siguen su camino con la cabeza llena de preguntas."])

[node name="S3_Casa" type="Area2D" parent="." unique_id=1620208162]
position = Vector2(4961, 230)
collision_layer = 0
collision_mask = 2
script = ExtResource("13_story")
conversation_lines = Array[String](["Más adelante, entre las rocas, alguien sale corriendo, gritando y llorando. Un poco más allá, Ethan solo observa."])

[node name="CollisionShape2D" type="CollisionShape2D" parent="S3_Casa" unique_id=858838622]
shape = SubResource("TrigShape3")

[node name="S3_Guardabosque" type="Area2D" parent="." unique_id=694830211]
position = Vector2(7005, 230)
collision_layer = 0
collision_mask = 2
script = ExtResource("13_story")
conversation_lines = Array[String](["Se acerca el guardabosque, siguiendo a la joven. Ella ve a Stephy y corre a buscar su protección, abrazándola, tiritando de miedo."])

[node name="CollisionShape2D" type="CollisionShape2D" parent="S3_Guardabosque" unique_id=1933685182]
shape = SubResource("TrigShape3")

[node name="S3_Combate2" type="Area2D" parent="." unique_id=985999434]
position = Vector2(8410, 230)
collision_layer = 0
collision_mask = 2
script = ExtResource("13_story")
conversation_lines = Array[String](["Comienza el siguiente combate. El guardabosque se interpone una vez más, y Thomas se enfurece.", "Thomas-¿Te enfrentas a nosotros y dejas escapar a esa bestia? ¿Dónde está tu conciencia?", "Elliot-Este tipo está loco. Es la segunda vez que me ataca hoy."])

[node name="CollisionShape2D" type="CollisionShape2D" parent="S3_Combate2" unique_id=822569007]
shape = SubResource("TrigShape3")

[node name="S3_Ranger2Cae" type="Node" parent="." unique_id=1992159606]
script = ExtResource("defeat_gd")
enemy_path = NodePath("../RangerWood2")
lines = Array[String](["Cae el guardabosque, todavía sin explicación para su actitud, mientras la joven y Stephy siguen temblando, aterradas.", "Caperucita-¿Y el lobo?", "Elliot-¿Cuál lobo? ¿Esa bestia gigante es un lobo?", "Thomas-Ya vamos por él, princesita.", "Elliot-¡¡¿QUÉ?!!", "Al ver a las dos chicas temblando, aflora su naturaleza protectora y, sin pensarlo, afirma:", "Elliot-Tranquila, pequeña. Hoy cenamos lobo a las brasas.", "Thomas mira a Ethan, que desvía la mirada, y luego se dirige a Elliot y a Jhon.", "Thomas-Vamos.", "Corren hacia donde huyó el lobo para darle alcance. Thomas se arrepiente un poco: era enorme."])
delay = 1.2

[node name="S3_LoboAmenaza" type="Area2D" parent="." unique_id=835155954]
position = Vector2(9852, 39)
collision_layer = 0
collision_mask = 2
script = ExtResource("13_story")
conversation_lines = Array[String](["Siguiendo los aullidos llegan a una gran sala de piedra: un círculo rojo en el suelo y dos cabezas de lobo talladas en la roca. Algo enorme los espera sin prisa.", "Lobo-Qué amables... Me traen la cena hasta la puerta.", "Elliot-Así que eres tú lo que asustó a esa niña.", "Lobo-Ella eligió el camino largo y yo el corto. Siempre llego primero, y siempre encuentro la mesa puesta.", "Lobo-Huelo su miedo desde aquí. Es casi tan dulce como el de ella.", "Lobo-Ya cené. Y aún tengo hambre. Vengan, uno por uno o todos juntos: mi estómago no distingue."])

